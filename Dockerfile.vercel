FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY src ./src
RUN mkdir -p build/classes && find src/main/java -name '*.java' > sources.txt && javac --release 17 -encoding UTF-8 -d build/classes @sources.txt
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/build/classes ./build/classes
COPY web ./web
COPY results/benchmarks.json ./results/benchmarks.json
ENV HOST=0.0.0.0 PORT=80
EXPOSE 80
CMD ["java","-cp","build/classes","studio.Server"]
